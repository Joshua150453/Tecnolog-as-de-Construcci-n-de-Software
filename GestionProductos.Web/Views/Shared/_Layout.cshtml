<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestión de Productos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<!-- Librería Cliente de SignalR desde CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    // Configurar la conexión al WebSocket (SignalR)
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/productoHub")
        .withAutomaticReconnect()
        .build();

    // Escuchar el evento enviado desde el servidor
    connection.on("RecibirNuevoProducto", function (nombreProducto) {
        // Crear alerta dinámica en pantalla
        const mensaje = `📢 ¡Nuevo producto registrado en tiempo real: "${nombreProducto}"!`;
        
        // Mostrar alerta de Bootstrap
        const alertaDiv = document.createElement("div");
        alertaDiv.className = "alert alert-success alert-dismissible fade show position-fixed bottom-0 end-0 m-3 z-3";
        alertaDiv.style.zIndex = "9999";
        alertaDiv.innerHTML = `
            <strong>Notificación WebSocket:</strong> ${mensaje}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        `;
        document.body.appendChild(alertaDiv);
    });

    // Iniciar la conexión WebSocket
    connection.start()
        .then(() => console.log("Conectado exitosamente al WebSocket de Productos."))
        .catch(err => console.error("Error al conectar con WebSocket:", err));
</script>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Producto" asp-action="Index">GestionProductos.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Producto" asp-action="Index">Productos</a>
                        </li>
                    </ul>

                    <!-- WIDGET DE CLIMA (Consumo de Servicio Externo REST desde Front-End) -->
                    <div id="clima-widget" class="d-flex align-items-center me-3 text-muted border rounded px-2 py-1 bg-light small">
                        <span class="me-1">📍 Arequipa:</span>
                        <strong id="clima-temp" class="text-primary">Cargando...</strong>
                    </div>

                    <!-- BOTÓN DE CAMBIO DE IDIOMA (i18n) -->
                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle btn-sm" type="button" id="dropdownIdioma" data-bs-toggle="dropdown" aria-expanded="false">
                            🌐 Idioma
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownIdioma">
                            <li>
                                <a class="dropdown-item" href="@Url.Action("CambiarIdioma", "Producto", new { culture = "es", returnUrl = Context.Request.Path + Context.Request.QueryString })">
                                    🇪🇸 Español
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="@Url.Action("CambiarIdioma", "Producto", new { culture = "en", returnUrl = Context.Request.Path + Context.Request.QueryString })">
                                    🇺🇸 English
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GestionProductos.Web
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- SCRIPT FRONT-END: Consumo de Servicio Externo (API Open-Meteo) -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // API gratuita de Open-Meteo para obtener temperatura de Arequipa
            const urlApiClima = "https://api.open-meteo.com/v1/forecast?latitude=-16.409&longitude=-71.537&current=temperature_2m&timezone=auto";

            fetch(urlApiClima)
                .then(response => {
                    if (!response.ok) throw new Error("Error en la respuesta de la API de clima");
                    return response.json();
                })
                .then(data => {
                    const temp = data.current.temperature_2m;
                    const unidad = data.current_units.temperature_2m;
                    document.getElementById("clima-temp").innerText = `${temp} ${unidad}`;
                })
                .catch(error => {
                    console.error("Error al consumir el servicio externo de clima:", error);
                    document.getElementById("clima-temp").innerText = "N/D";
                });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>